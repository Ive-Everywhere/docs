{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Eluu Docs",
  "description": "Build AI colleagues that run business operations across every tool you use.",
  "colors": {
    "primary": "#614051",
    "light": "#755A68",
    "dark": "#614051"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {"anchor": "Home", "icon": "house", "href": "/"},
        {"anchor": "App", "icon": "external-link", "href": "https://app.eluu.ai"},
        {"anchor": "Help", "icon": "life-buoy", "href": "mailto:hello@eluu.ai"}
      ]
    },
    "directory": "card",
    "groups": [
      {"group": "Concepts", "icon": "lightbulb", "expanded": true, "pages": ["concepts/colleagues", "concepts/hard-disk", "concepts/sessions", "concepts/jobs", "concepts/views", "concepts/integrations"]},
      {"group": "Sessions", "icon": "message-square", "expanded": true, "pages": ["sessions/starting-a-session", "sessions/document-authoring", "sessions/sub-agents", "sessions/browser-use", "sessions/using-skills"]},
      {"group": "Colleagues", "icon": "users-round", "expanded": true, "pages": ["colleagues/overview", "colleagues/skills", "colleagues/commands", "colleagues/integrations", "colleagues/memory"]},
      {"group": "Views", "icon": "layout-dashboard", "expanded": true, "pages": ["views/overview", "views/examples"]},
      {"group": "Slack", "icon": "slack", "expanded": true, "pages": ["slack/overview", "slack/eluu-bot", "slack/custom-app", "slack/channel-restrictions", "slack/user-mapping"]},
      {"group": "Settings", "icon": "settings", "expanded": true, "pages": ["settings/inviting-your-team", "settings/api-keys", "settings/billing"]},
      {"group": "Integrations", "icon": "plug", "expanded": true, "pages": ["integrations/overview", "integrations/team-vs-personal"]},
      {"group": "Techniques", "icon": "wand-sparkles", "expanded": true, "pages": ["techniques/skill-creation", "techniques/verification-loops", "techniques/sub-agents-for-verification", "techniques/handoffs"]}
    ]
  },
  "logo": {"light": "/images/logo-light.svg", "dark": "/images/logo-dark.svg"},
  "navbar": {"links": [], "primary": {"type": "button", "label": "Open Eluu", "href": "https://app.eluu.ai"}},
  "footer": {
    "socials": {
      "x": "https://x.com/eluuai",
      "linkedin": "https://linkedin.com/company/eluu-ai"
    }
  },
  "fonts": {
    "family": "Geist"
  }
}
